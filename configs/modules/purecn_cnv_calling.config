/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PureCN CNV calling subworkflow module options
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    withName: '.*CNV_CALLING:PURECN_FORMAT_VCF' {
        container = "${params.container_dir}/bcftools-1.23.1_python-utils-3.9.1.sif"

        publishDir = [
            [ 
                path: "${params.outdir}/${params.subdir}/vcf/",
                mode: 'copy',
                overwrite: true,
                pattern: '*.agg.pon.vep.markgerm.purecn.vcf.gz',
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],

            [
        path: "${params.outdir}/${params.subdir}/vcf/",
        mode: 'copy',
        overwrite: true,
        pattern: '*.agg.pon.vep.markgerm.purecn.vcf.gz.tbi',
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ]
        ext.when    = params.purecn
        
    }
    
    withName: '.*CNV_CALLING:PURECN_COVERAGE' {
        container = "${params.container_dir}/purecn-2.10.0_markusriester-amd64.sif"

        publishDir = [
            [ 
                path: "${params.outdir}/${params.subdir}/purecn",
                mode: 'copy',
                overwrite: true,
                pattern: '*_coverage*.txt.gz',
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]

        ]
        ext.when    = params.purecn
    }

    withName: '.*CNV_CALLING:PURECN_CALL' {
        container = "${params.container_dir}/purecn-2.10.0_markusriester-amd64.sif"

        ext.when    = params.purecn
        ext.args    = [
            "--genome hg38",
            "--fun-segmentation PSCBS",
            "--cores 8",
            "--max-segments 500",
            "--max-non-clonal 0.3",
            "--model betabin",
            "--post-optimize TRUE",
            "--seed 42",
            "--interval-padding 100",
            "--popaf-info-field POP_AF"
        ]
    }

    withName: '.*CNV_CALLING:PURECN_LOH_EXTRACT' {
        container = "${params.container_dir}/python_hcvpipe.sif"

        publishDir = [
            path: "${params.outdir}/${params.subdir}/purecn",
            mode: 'copy',
            overwrite: true,
            pattern: '*_purecn_loh_filtered.csv',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.when    = params.purecn
    }

    withName: '.*CNV_CALLING:PURECN_CNLOH_GENS' {
        container = "${params.container_dir}/python_hcvpipe.sif"

        publishDir = [
            [
            path: "${params.outdir}/${params.subdir}/purecn",
            mode: 'copy',
            overwrite: true,
            pattern: '*_informative_cnloh_snp.tsv',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],

             [
            path: "${params.outdir}/${params.subdir}/purecn",
            mode: 'copy',
            overwrite: true,
            pattern: '*_baf_purecn_cnlohseg.png',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],

            [
            path: "${params.outdir}/${params.subdir}/gens",
            mode: 'copy',
            overwrite: true,
            pattern: '*_purecn_cnloh_gens.tsv',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],

            [
            path: "${params.outdir}/${params.subdir}/gens",
            mode: 'copy',
            overwrite: true,
            pattern: '*_cnloh_coyote.json',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        ]
        ext.when    = params.purecn
        }
}