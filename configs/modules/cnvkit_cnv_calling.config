/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    CNVkit CNV calling subworkflow module options
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    withName: '.*CNV_CALLING:CNVKIT:.*' {
        container = "${params.container_dir}/cnvkit-0.9.9.sif"
        ext.when = params.cnvkit
    }

    withName: '.*CNV_CALLING:CNVKIT:CNVKIT_FULL' {

        publishDir = [
            path: "${params.outdir}/${params.subdir}/cnvkit",
            mode: 'copy',
            overwrite: true,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*CNV_CALLING:CNVKIT:CNVKIT_BACKBONE' {

        publishDir = [
            path: "${params.outdir}/${params.subdir}/cnvkit",
            mode: 'copy',
            overwrite: true,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*CNV_CALLING:CNVKIT:CNVKIT_EXONS' {

        publishDir = [
            path: "${params.outdir}/${params.subdir}/cnvkit",
            mode: 'copy',
            overwrite: true,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*CNV_CALLING:CNVKIT:CNVKIT_GENS' {
        container = "${params.container_dir}/cnvkit099.sif"
    }

    withName: '.*CNV_CALLING:CNVKIT:GENS_PART_BGZIP' {
        container = "${params.container_dir}/gzip-1.14_tabix-1.11.sif"
        ext.prefix = { input_file.baseName }
        ext.suffix = 'bed.gz'

        publishDir = [
            path: "${params.outdir}/${params.subdir}/gens",
            mode: 'copy',
            overwrite: true,
            saveAs: { filename ->
                def basename = filename.tokenize('/').last()
                if (params.cnvkit_split && ['.exons.', '.backbone.'].any { basename.contains(it) } && basename.endsWith('.bed.gz')) {
                    return basename
                }
                return null
            }
        ]
    }

    withName: '.*CNV_CALLING:CNVKIT:GENS_PREPARE_BED' {
        container = "${params.container_dir}/python_utils-3.9.1.sif"
        ext.prefix = { "${meta.id}.base.${vc}" }
        ext.suffix = 'bed'
    }

    withName: '.*CNV_CALLING:CNVKIT:GENS_BASE_SORT' {
        container = "${params.container_dir}/bedtools-2.31.1.sif"
        ext.prefix = { "${meta.id}.base.${vc}" }
        ext.suffix = 'sorted.bed'
    }

    withName: '.*CNV_CALLING:CNVKIT:GENS_EXPAND_ALLELES' {
        container = "${params.container_dir}/python_utils-3.9.1.sif"
        ext.prefix = { "${meta.id}.merged.${vc}" }
        ext.suffix = 'bed'
    }

    withName: '.*CNV_CALLING:CNVKIT:GENS_MERGED_SORT' {
        container = "${params.container_dir}/bedtools-2.31.1.sif"
        ext.prefix = { "${meta.id}.merged.sorted.${vc}" }
        ext.suffix = 'bed'
    }

    withName: '.*CNV_CALLING:CNVKIT:GENS_MERGED_BGZIP' {
        container = "${params.container_dir}/bedtools-2.31.1.sif"
        ext.prefix = { input_file.baseName }
        ext.suffix = 'bed.gz'
    }

    withName: '.*CNV_CALLING:CNVKIT:GENS_TABIX_INDEX' {
        // Retain the full/split indexing environments used by the previous GENS chain.
        container = "${params.container_dir}/bedtools-2.31.1.sif"
        ext.args = '-f'
        publishDir = [
            path: "${params.outdir}/${params.subdir}/gens",
            mode: 'copy',
            overwrite: true,
            saveAs: { filename ->
                def basename = filename.tokenize('/').last()
                def expected_part = params.cnvkit_split ? '.merged.sorted.' : '.full.'
                basename.contains(expected_part) &&
                    (basename.endsWith('.bed.gz') || basename.endsWith('.bed.gz.tbi')) ? basename : null
            }
        ]
    }

    withName: '.*CNV_CALLING:CNVKIT:CNVKIT_PLOT' {

        publishDir = [
            path: "${params.outdir}/${params.subdir}/plots",
            mode: 'copy',
            overwrite: true,
            pattern: '*.png',
        ]
    }

    withName: '.*CNV_CALLING:CNVKIT:CNVKIT_CALL' {

        publishDir = [
            path: "${params.outdir}/${params.subdir}/cnvkit/segments/",
            mode: 'copy',
            overwrite: true,
            pattern: '*call*.cns',
        ]
    }

    withName: '.*CNV_CALLING:CNVKIT:CNVKIT_CALL_TC' {

        publishDir = [
            path: "${params.outdir}/${params.subdir}/cnvkit/segments/",
            mode: 'copy',
            overwrite: true,
            pattern: '*call*.cns',
        ]
    }

    withName: '.*CNV_CALLING:CNVKIT:CNVKIT_EXPORT_VCF$' {

        publishDir = [
            path: "${params.outdir}/${params.subdir}/svvcf/",
            mode: 'copy',
            overwrite: true,
            pattern: '*.vcf',
        ]
    }

    withName: '.*CNV_CALLING:CNVKIT:CNVKIT_EXPORT_VCF_TC' {

        ext.suffix = { "${part}.cnvkit.purity.vcf" }

        publishDir = [
            path: "${params.outdir}/${params.subdir}/svvcf/",
            mode: 'copy',
            overwrite: true,
            pattern: '*.cnvkit.purity.vcf',
        ]
    }

    withName: '.*CNV_CALLING:CNVKIT:GENS_WRITE_COMMANDS' {
        container = "${params.container_dir}/python_utils-3.9.1.sif"
        ext.prefix = { "${meta.id}" }

        publishDir = [
            [
                path: "${params.outdir}/cron/gens",
                mode: 'copy',
                overwrite: true,
                pattern: '*.gens',
            ],
            [
                path: "${params.outdir}/cron/gens",
                mode: 'copy',
                overwrite: true,
                pattern: '*.gens_v4_somatic',
            ],
        ]
    }
}
