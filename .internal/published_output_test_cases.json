    },
    {
      "id": "qc_solid_unpaired",
      "entry": "QC",
      "profiles": ["hg38", "solid"],
      "csv_variable": "UNPAIRED_SOLID_CSV",
      "published_subdir": "solid_hg38",
      "reason": "QC-only tumor-only behavior."
    },
    {
      "id": "snvpon_solid",
      "entry": "SNVPON",
      "profiles": ["hg38", "solid"],
      "csv_variable": "SNV_PON_CSV",
      "published_subdir": "solid_hg38",
      "reason": "SNV panel-of-normals creation outputs."
    },
    {
      "id": "cnvpon_solid",
      "entry": "CNVPON",
      "profiles": ["hg38", "solid"],
      "csv_variable": "CNV_PON_CSV",
      "published_subdir": "solid_hg38",
      "reason": "CNV reference/PON creation outputs."
    }
  ]
}
