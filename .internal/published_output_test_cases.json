{
  "description": "Published-output parity cases for comparing main/master against the containers refactor branch. These are command templates only; they are not executed by the internal scripts.",
  "assumptions": [
    "Run each case once from the baseline branch and once from the candidate branch.",
    "Use separate params.outdir values for baseline and candidate so published files do not overwrite each other.",
    "Compare only the published output subdirectory for each case, not Nextflow work directories.",
    "Provide CSV paths through environment variables or replace the placeholders before running."
  ],
  "variables": {
    "BASELINE_OUTDIR": "Published output root for the baseline branch run.",
    "CANDIDATE_OUTDIR": "Published output root for the containers branch run.",
    "PAIRED_SOLID_CSV": "Two-sample tumor/normal solid CSV.",
    "UNPAIRED_SOLID_CSV": "Tumor-only solid CSV.",
    "PAIRED_GMSHEM_CSV": "Two-sample tumor/normal GMSHem CSV.",
    "UNPAIRED_GMSHEM_CSV": "Tumor-only GMSHem CSV.",
    "PAIRED_MYELOID_CSV": "Two-sample tumor/normal myeloid CSV.",
    "UNPAIRED_MYELOID_CSV": "Tumor-only myeloid CSV.",
    "PAIRED_LYMPHOID_CSV": "Two-sample tumor/normal lymphoid CSV.",
    "UNPAIRED_LYMPHOID_CSV": "Tumor-only lymphoid CSV.",
    "PAIRED_PARPI_CSV": "Two-sample tumor/normal PARP_inhib CSV.",
    "UNPAIRED_PARPI_CSV": "Tumor-only PARP_inhib CSV.",
    "SNV_PON_CSV": "Cohort CSV for SNVPON creation.",
    "CNV_PON_CSV": "Cohort CSV for CNVPON/reference creation."
  },
  "cases": [
    {
      "id": "spp_solid_paired",
      "entry": "SPP",
      "profiles": ["hg38", "solid"],
      "csv_variable": "PAIRED_SOLID_CSV",
      "published_subdir": "solid_hg38",
      "reason": "Full solid tumor-normal path: alignment, SNV, CNVkit split, GATK CNV, Manta, QC, VCF QC, CNV annotate, fusions, biomarkers, coyote."
    },
    {
      "id": "spp_solid_unpaired",
      "entry": "SPP",
      "profiles": ["hg38", "solid"],
      "csv_variable": "UNPAIRED_SOLID_CSV",
      "published_subdir": "solid_hg38",
      "reason": "Tumor-only solid path: catches unpaired SNV filters, tumor-only CNV output, contamination, ID-SNP non-paired behavior."
    },
    {
      "id": "spp_gmshem_paired",
      "entry": "SPP",
      "profiles": ["hg38", "GMSHem"],
      "csv_variable": "PAIRED_GMSHEM_CSV",
      "published_subdir": "gmshem",
      "reason": "Hematology panel with TNscope, D4 QC, Manta, GATK CNV, CNV backbone/ID-SNP backbone differences."
    },
    {
      "id": "spp_gmshem_unpaired",
      "entry": "SPP",
      "profiles": ["hg38", "GMSHem"],
      "csv_variable": "UNPAIRED_GMSHEM_CSV",
      "published_subdir": "gmshem",
      "reason": "Tumor-only GMSHem path with TNscope unpaired and D4 QC."
    },
    {
      "id": "spp_myeloid_paired",
      "entry": "SPP",
      "profiles": ["hg38", "myeloid"],
      "csv_variable": "PAIRED_MYELOID_CSV",
      "published_subdir": "myeloid38",
      "reason": "Myeloid path without Manta/GATK/fusions/biomarkers; catches CNVkit non-split and myeloid-specific QC/ID-SNP settings."
    },
    {
      "id": "spp_myeloid_unpaired",
      "entry": "SPP",
      "profiles": ["hg38", "myeloid"],
      "csv_variable": "UNPAIRED_MYELOID_CSV",
      "published_subdir": "myeloid38",
      "reason": "Tumor-only myeloid path and non-split CNVkit output names."
    },
    {
      "id": "spp_lymphoid_paired",
      "entry": "SPP",
      "profiles": ["hg38", "lymphoid"],
      "csv_variable": "PAIRED_LYMPHOID_CSV",
      "published_subdir": "lymph_hg38",
      "reason": "Lymphoid path with panel-specific references and no fusions/other biomarkers."
    },
    {
      "id": "spp_lymphoid_unpaired",
      "entry": "SPP",
      "profiles": ["hg38", "lymphoid"],
      "csv_variable": "UNPAIRED_LYMPHOID_CSV",
      "published_subdir": "lymph_hg38",
      "reason": "Tumor-only lymphoid path."
    },
    {
      "id": "spp_parp_paired",
      "entry": "SPP",
      "profiles": ["hg38", "PARP_inhib"],
      "csv_variable": "PAIRED_PARPI_CSV",
      "published_subdir": "PARP_inhib",
      "reason": "PARP path with D4 QC, disabled TNscope/Pindel, and non-split CNVkit."
    },
    {
      "id": "spp_parp_unpaired",
      "entry": "SPP",
      "profiles": ["hg38", "PARP_inhib"],
      "csv_variable": "UNPAIRED_PARPI_CSV",
      "published_subdir": "PARP_inhib",
      "reason": "Tumor-only PARP path."
    },
    {
